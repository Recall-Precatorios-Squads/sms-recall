{
  "name": "sms-recall",
  "version": "1.0.0",
  "private": true,
  "description": "Disparo de SMS pelos chips de celulares Android (app sms-gate), com fila no PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node scripts/copiar-public.mjs",
    "start": "node dist/servidor.js",
    "worker": "node dist/worker/index.js",
    "migrate": "prisma migrate deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.8",
    "prisma": "^6.19.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
