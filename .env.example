# Copie para .env e preencha, ou use a tela Configurações (http://localhost:3333/config).
# O .env não vai para o Git.

PORT=3333

# local = cada celular é um servidor (pelo cabo USB ou Wi-Fi); cloud = nuvem do sms-gate.
SMSGATE_MODE=local

# Celular 1 (pelo cabo: adb forward tcp:8080 tcp:8080)
SMSGATE_URL=http://127.0.0.1:8080
SMSGATE_USER=
SMSGATE_PASSWORD=

# Celular 2, opcional (pelo cabo: adb -s <serial> forward tcp:8081 tcp:8080)
SMSGATE_2_URL=
SMSGATE_2_USER=
SMSGATE_2_PASSWORD=
