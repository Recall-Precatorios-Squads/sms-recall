# Copie para .env e preencha. O .env NÃO vai para o Git.

# ── Obrigatórios ──
# Banco (o compose monta a DATABASE_URL a partir desta senha)
POSTGRES_PASSWORD=troque-por-uma-senha-longa
# Cifra as senhas dos celulares no banco. Gere com: openssl rand -hex 32   (NÃO troque depois)
APP_SECRET=
# Primeiro administrador: criado na primeira subida, se ainda não existir nenhum usuário.
ADMIN_EMAIL=admin@empresa.com.br
ADMIN_NOME=Administrador
ADMIN_SENHA=

# ── Envio ──
# Fora desta janela nada sai (as mensagens esperam na fila). Horário do fuso TZ_TELA.
JANELA_ENVIO=08:00-20:00
# Máximo de SMS por chip por dia (cada chip pode ter o próprio, na tela Aparelhos e chips).
COTA_DIARIA_CHIP=167
# Intervalo por chip das mensagens que chegam pela API /v1 (os disparos da tela escolhem o deles).
INTERVALO_API_MIN_SEGUNDOS=45
INTERVALO_API_MAX_SEGUNDOS=80
# Endereço que já vem preenchido em "Adicionar celular" (IP do celular na Wi-Fi + porta do app sms-gate)
CELULAR_URL_PADRAO=http://192.168.172.12:8080
# 1 = ensaio: nenhum SMS sai, os celulares são imitados
SMSGATE_SIMULADO=0

# ── Alertas para a TI (celular fora, chip pausado, mensagem incerta, backup atrasado) ──
# Telegram: crie um bot com o @BotFather e pegue o id do grupo/conversa.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# E/ou um webhook que recebe POST {"text": "..."} (Slack, Google Chat, Teams...)
ALERTA_WEBHOOK_URL=

# ── Infra ──
# Porta da tela no mini PC (o Traefik escuta nela e distribui entre as réplicas do app)
PORTA=3000
APP_REPLICAS=2
TZ_TELA=America/Sao_Paulo
BACKUP_MANTER_DIAS=14
# Só para o túnel (docker compose --profile tunel up -d)
TUNNEL_TOKEN=
