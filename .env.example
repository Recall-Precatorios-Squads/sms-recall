# Copie para .env e preencha. O .env NÃO vai para o Git.

# Banco (o compose monta a DATABASE_URL a partir desta senha)
POSTGRES_PASSWORD=troque-por-uma-senha-longa

# Chave para cifrar as senhas dos celulares no banco e assinar a sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Primeiro administrador: criado na primeira subida, se ainda não existir nenhum usuário.
ADMIN_EMAIL=admin@empresa.com.br
ADMIN_NOME=Administrador
ADMIN_SENHA=

# Porta da tela no mini PC
PORTA=3000

# Fuso usado nas telas e no "hoje" do painel
TZ_TELA=America/Sao_Paulo
