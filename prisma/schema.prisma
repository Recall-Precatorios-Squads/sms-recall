// Banco do sms-recall. Tabelas no plural, colunas em snake_case, horários em TIMESTAMPTZ (UTC).
// A tabela `mensagens` É a fila: o worker reserva linhas com FOR UPDATE SKIP LOCKED.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMIN
  OPERADOR
}

enum StatusDisparo {
  ENVIANDO
  CONCLUIDO
  CANCELADO
}

enum StatusMensagem {
  PENDENTE
  RESERVADA
  ENVIANDO
  ACEITA
  ENVIADA
  ENTREGUE
  FALHOU
  INCERTA
  CANCELADA
  SEM_CONFIRMACAO
}

enum NivelEvento {
  INFO
  AVISO
  ERRO
}

model Usuario {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  nome      String
  senhaHash String     @map("senha_hash")
  papel     Papel      @default(OPERADOR)
  ativo     Boolean    @default(true)
  criadoEm  DateTime   @default(now()) @map("criado_em") @db.Timestamptz(3)
  sessoes   Sessao[]
  disparos  Disparo[]
  eventos   Evento[]
  bloqueios Bloqueio[]

  @@map("usuarios")
}

model Sessao {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  usuarioId Int      @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiraEm  DateTime @map("expira_em") @db.Timestamptz(3)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([usuarioId])
  @@map("sessoes")
}

model Aparelho {
  id              Int        @id @default(autoincrement())
  nome            String     @unique
  url             String
  usuario         String
  senhaCifrada    String     @map("senha_cifrada")
  ativo           Boolean    @default(true)
  online          Boolean    @default(false)
  bateria         Int?
  detalhe         String?
  ultimoContatoEm DateTime?  @map("ultimo_contato_em") @db.Timestamptz(3)
  criadoEm        DateTime   @default(now()) @map("criado_em") @db.Timestamptz(3)
  chips           Chip[]
  respostas       Resposta[]

  @@map("aparelhos")
}

model Chip {
  id             Int        @id @default(autoincrement())
  aparelhoId     Int        @map("aparelho_id")
  aparelho       Aparelho   @relation(fields: [aparelhoId], references: [id], onDelete: Cascade)
  simNumero      Int        @map("sim_numero")
  operadora      String?
  telefone       String?
  ativo          Boolean    @default(true)
  presente       Boolean    @default(true)
  proximoEnvioEm DateTime   @default(now()) @map("proximo_envio_em") @db.Timestamptz(3)
  falhasSeguidas Int        @default(0) @map("falhas_seguidas")
  cotaDiaria     Int?       @map("cota_diaria")
  criadoEm       DateTime   @default(now()) @map("criado_em") @db.Timestamptz(3)
  mensagens      Mensagem[]
  eventos        Evento[]
  respostas      Resposta[]

  @@unique([aparelhoId, simNumero])
  @@map("chips")
}

model Disparo {
  id             Int           @id @default(autoincrement())
  nome           String
  criadoPorId    Int?          @map("criado_por_id")
  criadoPor      Usuario?      @relation(fields: [criadoPorId], references: [id])
  timeId         Int?          @map("time_id")
  time           Time?         @relation(fields: [timeId], references: [id])
  bloqueados     Int           @default(0)
  status         StatusDisparo @default(ENVIANDO)
  intervaloMinMs Int           @map("intervalo_min_ms")
  intervaloMaxMs Int           @map("intervalo_max_ms")
  total          Int
  abordagens     Int           @default(0)
  duplicados     Int           @default(0)
  criadoEm       DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  terminadoEm    DateTime?     @map("terminado_em") @db.Timestamptz(3)
  mensagens      Mensagem[]
  eventos        Evento[]
  respostas      Resposta[]

  @@index([criadoPorId])
  @@index([timeId])
  @@index([status])
  @@map("disparos")
}

model Mensagem {
  id                 Int            @id @default(autoincrement())
  disparoId          Int?           @map("disparo_id")
  disparo            Disparo?       @relation(fields: [disparoId], references: [id])
  timeId             Int?           @map("time_id")
  time               Time?          @relation(fields: [timeId], references: [id])
  chaveIdempotencia  String?        @map("chave_idempotencia")
  prioridade         Int            @default(0)
  intervaloMinMs     Int?           @map("intervalo_min_ms")
  intervaloMaxMs     Int?           @map("intervalo_max_ms")
  linha              Int?
  telefone           String
  nome               String?
  texto              String
  indiceAbordagem    Int?           @map("indice_abordagem")
  status             StatusMensagem @default(PENDENTE)
  chipId             Int?           @map("chip_id")
  chip               Chip?          @relation(fields: [chipId], references: [id])
  idExterno          String?        @map("id_externo")
  tentativas         Int            @default(0)
  proximaTentativaEm DateTime       @default(now()) @map("proxima_tentativa_em") @db.Timestamptz(3)
  reservadaAte       DateTime?      @map("reservada_ate") @db.Timestamptz(3)
  enviandoEm         DateTime?      @map("enviando_em") @db.Timestamptz(3)
  aceitaEm           DateTime?      @map("aceita_em") @db.Timestamptz(3)
  entregueEm         DateTime?      @map("entregue_em") @db.Timestamptz(3)
  detalhe            String?
  criadoEm           DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime       @default(now()) @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  avisos    Aviso[]
  respostas Resposta[]

  @@unique([timeId, chaveIdempotencia])
  @@index([status, proximaTentativaEm])
  @@index([disparoId])
  @@index([chipId, enviandoEm])
  @@index([timeId, criadoEm])
  @@map("mensagens")
}

model Evento {
  id        Int         @id @default(autoincrement())
  tipo      String
  nivel     NivelEvento @default(INFO)
  texto     String
  disparoId Int?        @map("disparo_id")
  disparo   Disparo?    @relation(fields: [disparoId], references: [id])
  chipId    Int?        @map("chip_id")
  chip      Chip?       @relation(fields: [chipId], references: [id])
  usuarioId Int?        @map("usuario_id")
  usuario   Usuario?    @relation(fields: [usuarioId], references: [id])
  criadoEm  DateTime    @default(now()) @map("criado_em") @db.Timestamptz(3)
  alerta    Alerta?

  @@index([criadoEm])
  @@index([disparoId])
  @@index([chipId])
  @@index([usuarioId])
  @@map("eventos")
}

enum StatusEntrega {
  PENDENTE
  ENVIADO
  FALHOU
}

/// Time (sistema ou área) que usa a API /v1 com a própria chave.
model Time {
  id           Int        @id @default(autoincrement())
  nome         String     @unique
  chaveHash    String     @unique @map("chave_hash")
  chavePrefixo String     @map("chave_prefixo")
  cotaDiaria   Int        @default(1000) @map("cota_diaria")
  prioridade   Int        @default(0)
  ativo        Boolean    @default(true)
  webhookUrl   String?    @map("webhook_url")
  criadoEm     DateTime   @default(now()) @map("criado_em") @db.Timestamptz(3)
  disparos     Disparo[]
  mensagens    Mensagem[]
  avisos       Aviso[]
  respostas    Resposta[]

  @@map("times")
}

/// Telefone que não recebe mais SMS (pediu para sair, número errado...).
model Bloqueio {
  id          Int      @id @default(autoincrement())
  telefone    String   @unique
  motivo      String
  criadoPorId Int?     @map("criado_por_id")
  criadoPor   Usuario? @relation(fields: [criadoPorId], references: [id])
  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([criadoPorId])
  @@map("bloqueios")
}

/// Outbox de alertas: gravado junto com o evento; o worker envia (Telegram e/ou webhook) com nova tentativa.
model Alerta {
  id                 Int           @id @default(autoincrement())
  eventoId           Int           @unique @map("evento_id")
  evento             Evento        @relation(fields: [eventoId], references: [id])
  status             StatusEntrega @default(PENDENTE)
  tentativas         Int           @default(0)
  proximaTentativaEm DateTime      @default(now()) @map("proxima_tentativa_em") @db.Timestamptz(3)
  enviadoEm          DateTime?     @map("enviado_em") @db.Timestamptz(3)
  erro               String?

  @@index([status, proximaTentativaEm])
  @@map("alertas")
}

/// Outbox de avisos aos times: quando o status de uma mensagem do time muda, o worker chama o webhook do time.
model Aviso {
  id                 Int           @id @default(autoincrement())
  mensagemId         Int           @map("mensagem_id")
  mensagem           Mensagem      @relation(fields: [mensagemId], references: [id])
  timeId             Int           @map("time_id")
  time               Time          @relation(fields: [timeId], references: [id])
  statusMensagem     String        @map("status_mensagem")
  /// Preenchido quando o aviso é de resposta do contato (evento mensagem.respondida).
  respostaId         Int?          @map("resposta_id")
  resposta           Resposta?     @relation(fields: [respostaId], references: [id])
  status             StatusEntrega @default(PENDENTE)
  tentativas         Int           @default(0)
  proximaTentativaEm DateTime      @default(now()) @map("proxima_tentativa_em") @db.Timestamptz(3)
  enviadoEm          DateTime?     @map("enviado_em") @db.Timestamptz(3)
  erro               String?
  criadoEm           DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([status, proximaTentativaEm])
  @@index([mensagemId])
  @@index([timeId])
  @@index([respostaId])
  @@map("avisos")
}

/// Tentativas de login erradas por IP (o limite vale para todas as réplicas do app).
model TentativaLogin {
  id       Int      @id @default(autoincrement())
  ip       String
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([ip, criadoEm])
  @@map("tentativas_login")
}

/// Batida do worker: o painel e o /health mostram se o envio está vivo.
model BatidaWorker {
  id           String   @id
  ultimaEm     DateTime @map("ultima_em") @db.Timestamptz(3)
  foraDaJanela Boolean  @default(false) @map("fora_da_janela")

  @@map("batidas_worker")
}

/// SMS que o contato mandou de volta para um chip, lido do celular (GET /inbox do sms-gate).
/// Ligado à última mensagem enviada para aquele telefone nos 7 dias anteriores; sem mensagem, fica avulso.
/// Imutável: só entra, nunca é editado.
model Resposta {
  id         Int       @id @default(autoincrement())
  aparelhoId Int       @map("aparelho_id")
  aparelho   Aparelho  @relation(fields: [aparelhoId], references: [id], onDelete: Cascade)
  chipId     Int?      @map("chip_id")
  chip       Chip?     @relation(fields: [chipId], references: [id])
  idExterno  String    @map("id_externo")
  telefone   String
  texto      String
  recebidaEm DateTime  @map("recebida_em") @db.Timestamptz(3)
  mensagemId Int?      @map("mensagem_id")
  mensagem   Mensagem? @relation(fields: [mensagemId], references: [id])
  disparoId  Int?      @map("disparo_id")
  disparo    Disparo?  @relation(fields: [disparoId], references: [id])
  timeId     Int?      @map("time_id")
  time       Time?     @relation(fields: [timeId], references: [id])
  criadaEm   DateTime  @default(now()) @map("criada_em") @db.Timestamptz(3)
  avisos     Aviso[]

  @@unique([aparelhoId, idExterno])
  @@index([chipId])
  @@index([mensagemId])
  @@index([disparoId])
  @@index([timeId, recebidaEm])
  @@index([recebidaEm])
  @@index([telefone])
  @@map("respostas")
}
